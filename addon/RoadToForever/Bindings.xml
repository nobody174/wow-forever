<!--
  Road to Forever key bindings (ADDON_PLAN.md 6.1, 6.9).

  NOT listed in RoadToForever.toc on purpose: the client loads a file named
  exactly "Bindings.xml" from the addon's root folder by itself. Listed in the
  TOC it would also be parsed as a UI XML file, where <Bindings> is not a
  valid element (load error).

  Labels in the Key Bindings menu come from globals set in Locale.lua:
  BINDING_HEADER_ROADTOFOREVER (from header="ROADTOFOREVER") and
  BINDING_NAME_<name> for each binding.
  category="ADDONS" files them under the menu's AddOns section in clients
  with the newer key-binding menu; unverified in the Forever client
  (TESTING.md 10).

  The text inside each <Binding> is Lua run on key down. It only calls into
  the addon's one global, R2F (functions in Core.lua).
-->
<Bindings>
  <Binding name="R2F_TOGGLE" header="ROADTOFOREVER" category="ADDONS">
    R2F.Bindings.Toggle()
  </Binding>
  <Binding name="R2F_MACROS" category="ADDONS">
    R2F.Bindings.OpenMacros()
  </Binding>
  <Binding name="R2F_TALENTS" category="ADDONS">
    R2F.Bindings.OpenTalents()
  </Binding>
</Bindings>
